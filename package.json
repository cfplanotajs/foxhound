{
  "name": "foxhound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "migrate:deploy": "prisma migrate deploy",
    "test": "node --import=tsx --test tests/**/*.test.ts",
    "worker": "tsx scripts/worker.ts",
    "presets:seed": "tsx scripts/seed-presets.ts",
    "health:check": "tsx scripts/health-check.ts",
    "backup": "tsx scripts/backup.ts",
    "verify": "npm run prisma:generate && npm test && npm run lint && npm run build && npm run typecheck"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "archiver": "^7.0.1",
    "next": "15.2.4",
    "openai": "^4.100.0",
    "pngjs": "^7.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.14.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.24.0",
    "eslint-config-next": "15.2.4",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
