# Required: Prisma database connection string (local default uses SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Optional: OpenAI API key (server-side only). Leave blank for Demo Mode.
OPENAI_API_KEY=""

# Optional: model override for OpenAI image generation when request body does not specify model
OPENAI_IMAGE_MODEL=""

# Optional: OpenAI edit adapter preference. Supported: responses, images_edit
OPENAI_EDIT_ADAPTER="responses"

# Optional: base directory for generated images (absolute path or relative to repo root)
# Leave blank to use default ./generated
FOXHOUND_STORAGE_DIR=""

# Optional worker tuning (safe defaults shown)
WORKER_POLL_INTERVAL_MS="5000"
WORKER_MAX_ATTEMPTS="3"
WORKER_RETRY_BASE_MS="5000"
WORKER_STALLED_AFTER_MS="900000"
